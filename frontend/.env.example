# Variables de Entorno - Frontend

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# La app se sirve bajo /timeline (basePath). BASE_URL y NEXTAUTH_URL deben incluirlo.
# En producción: https://anthonycazares.cafe/timeline y https://anthonycazares.cafe/timeline/api/auth
NEXT_PUBLIC_BASE_URL=http://localhost:3000/timeline
# Opcional: por defecto /timeline. Se incrusta en build; debe coincidir con el basePath.
# NEXT_PUBLIC_BASE_PATH=/timeline

# NextAuth.js (NEXTAUTH_URL lleva el basePath + /api/auth)
NEXTAUTH_URL=http://localhost:3000/timeline/api/auth
NEXTAUTH_SECRET=change_this_to_a_very_secure_random_string

# Admin credentials (server-side only, not exposed to client)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Analytics (opcional)
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Sentry (opcional)
# NEXT_PUBLIC_SENTRY_DSN=""